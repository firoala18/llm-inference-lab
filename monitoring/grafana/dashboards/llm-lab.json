{
  "title": "LLM Inference Lab",
  "uid": "llm-lab",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service Status (der Wächter gegen den lautlosen Tod)",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"pod\"}", "legendFormat": "{{service}}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "colorMode": "background", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Durchsatz jetzt (Output-Tokens/s)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(vllm:generation_tokens_total[2m]))", "legendFormat": "tok/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Kosten pro 1k Output-Tokens ($0.50/h GPU ÷ tatsächlicher Durchsatz)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(0.50 / 3600) / clamp_min(sum(rate(vllm:generation_tokens_total[5m])), 0.1) * 1000",
          "legendFormat": "$/1k tok"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "description": "Kosten sind eine Auslastungseigenschaft: dieselbe GPU-Stunde wird billig oder teuer, je nachdem wie viele Tokens sie produziert. Idle → Preis explodiert."
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "KV-Cache-Füllstand (Parallelitätsbudget)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (model_name) (vllm:kv_cache_usage_perc) * 100", "legendFormat": "{{model_name}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Time to First Token — P50 / P99 (SLO: P99 < 2.5s)",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "P99 {{model_name}}" },
        { "refId": "B", "expr": "histogram_quantile(0.50, sum by (le, model_name) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "P50 {{model_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8 } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Durchsatz pro Modell (Output-Tokens/s)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[1m]))", "legendFormat": "{{model_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 8 } }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests: laufend vs. wartend (Warteschlange = Sättigung)",
      "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "vllm:num_requests_running", "legendFormat": "running {{model_name}}" },
        { "refId": "B", "expr": "vllm:num_requests_waiting", "legendFormat": "waiting {{model_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 8 } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU: Auslastung vs. VRAM (zwei verschiedene Ressourcen!)",
      "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "gpu_utilization_percent", "legendFormat": "Compute-Auslastung %" },
        { "refId": "B", "expr": "gpu_memory_used_mib / gpu_memory_total_mib * 100", "legendFormat": "VRAM belegt %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 8 } }, "overrides": [] },
      "description": "Dein Screenshot von Tag 5 als Panel: 96% VRAM bei 0% Auslastung ist normal — Speicher ist statisch reserviert, Compute folgt dem Traffic."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Inter-Token-Latenz P99 (Flüssigkeit des Streamings)",
      "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le, model_name) (rate(vllm:inter_token_latency_seconds_bucket[5m])))", "legendFormat": "P99 {{model_name}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 8 } }, "overrides": [] }
    }
  ]
}
