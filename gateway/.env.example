# Copy to .env and fill in. .env is gitignored — it holds secrets and the
# pod-specific backend URL, which changes on every pod deploy.

# vLLM backend: RunPod proxy URL of the current pod, WITH the /v1 suffix
VLLM_API_BASE=https://<pod-id>-8000.proxy.runpod.net/v1

# The vLLM server's own API key (set as pod env var)
VLLM_API_KEY=sk-lab-...

# Gateway admin key — mints, inspects and revokes virtual keys. Must start with sk-
LITELLM_MASTER_KEY=sk-master-...
